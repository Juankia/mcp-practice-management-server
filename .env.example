# ---------------------------------------------------------------------------
# mcp-practice-management-server — example configuration
# Copy to .env and run with: node --env-file=.env dist/index.js
# Never commit real credentials. The model never sees any of these values.
# ---------------------------------------------------------------------------

# Which backend to use: "memory" (seeded fictional data, default) or "rest".
PM_ADAPTER=memory

# REST adapter (only used when PM_ADAPTER=rest)
PM_API_BASE_URL=https://api.example-practice-suite.com/v1
PM_OAUTH_TOKEN_URL=https://auth.example-practice-suite.com/oauth/token
PM_OAUTH_CLIENT_ID=replace-me
PM_OAUTH_CLIENT_SECRET=replace-me
PM_OAUTH_SCOPE=contacts matters tasks time_entries
PM_HTTP_TIMEOUT_MS=10000

# Transport: "stdio" (default, for Claude Desktop / Claude Code) or "http" (Streamable HTTP)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3333
# Required when MCP_TRANSPORT=http: clients must send "Authorization: Bearer <token>"
MCP_HTTP_AUTH_TOKEN=generate-a-long-random-string

# trace | debug | info | warn | error
LOG_LEVEL=info
